    <meta name="robots" content="index, follow" />

    <title>Lightning AI</title>
    <!-- Structured data for SERPs -->
    <script type="application/ld+json">
      {
        "@context": "http://schema.org",
        "@type": "Corporation",
        "name": "Lightning AI",
        "url": "https://lightning.ai",
        "description": "The platform to train, deploy and build AI with PyTorch, Lightning fast. From the makers of PyTorch Lightning.",
        "logo": "https://lightningaidev.wpengine.com/wp-content/uploads/2023/07/logo.svg",
        "founder": {
          "@type": "Person",
          "name": "William Falcon",
          "url": "https://twitter.com/_willfalcon"
        },
        "sameAs": [
          "https://twitter.com/LightningAI",
          "https://discord.gg/MWAEvnC5fU",
          "https://github.com/lightning-ai/lightning",
          "https://www.linkedin.com/company/pytorch-lightning"
        ]
      }
    </script>
    <script type="module" crossorigin src="/static/entry-DwloixSe.js"></script>
    <link rel="stylesheet" crossorigin href="/static/asset-DpsRipQV.css">
  <link rel="manifest" href="/manifest.webmanifest"></head>

  <body>
    <noscript>You need to enable JavaScript to run this app.</noscript>
    <div id="root"></div>
    <!-- With JS disabled nothing removes the splash — hide it so the noscript
         message above stays readable. -->
    <noscript
      ><style>
        #lai-boot-splash {
          display: none;
        }
      </style></noscript
    >
    <!-- aria-hidden on the decorative stack only — the stuck hint below must
         stay reachable by assistive tech (it's the sole recovery affordance
         on a boot that never completes) -->
    <div id="lai-boot-splash" data-testid="global-app-loader">
      <div class="lai-loader-stack" aria-hidden="true">
        <div class="lai-loader-wrap">
          <div class="lai-lightning-loader">
            <div class="lai-loader-inner">
              <div class="lai-loader-core">
                <div class="lai-loader-spin"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <p class="lai-boot-stuck">Taking longer than expected — try refreshing the page.</p>
    </div>
  </body>
</html>
